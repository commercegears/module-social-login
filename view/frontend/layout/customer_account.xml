<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="customer_account_navigation">
            <block class="Magento\Customer\Block\Account\SortLinkInterface" name="customer-account-navigation-social-login-link"
                   ifconfig="commercegears_sociallogin/general/enabled">
                <arguments>
                    <argument name="label" xsi:type="string" translate="true">Connected Accounts</argument>
                    <argument name="path" xsi:type="string">sociallogin/account</argument>
                    <argument name="sortOrder" xsi:type="number">175</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
