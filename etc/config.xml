<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <softaware_sociallogin>
            <general>
                <enabled>0</enabled>
                <login_mode>redirect</login_mode>
                <button_style>icon_text</button_style>
                <button_theme>light</button_theme>
            </general>
            <display>
                <login_page>1</login_page>
                <register_page>1</register_page>
                <auth_popup>1</auth_popup>
                <checkout>0</checkout>
            </display>
            <account>
                <link_mode>auto</link_mode>
                <send_welcome_email>1</send_welcome_email>
                <customer_group>0</customer_group>
                <redirect>stay</redirect>
            </account>
            <google>
                <enabled>0</enabled>
                <client_secret backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <sort_order>10</sort_order>
            </google>
            <apple>
                <enabled>0</enabled>
                <private_key backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <sort_order>20</sort_order>
            </apple>
            <facebook>
                <enabled>0</enabled>
                <client_secret backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <graph_version>v23.0</graph_version>
                <sort_order>30</sort_order>
            </facebook>
            <microsoft>
                <enabled>0</enabled>
                <client_secret backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <tenant>common</tenant>
                <sort_order>40</sort_order>
            </microsoft>
            <github>
                <enabled>0</enabled>
                <client_secret backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <sort_order>50</sort_order>
            </github>
            <linkedin>
                <enabled>0</enabled>
                <client_secret backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <sort_order>60</sort_order>
            </linkedin>
            <amazon>
                <enabled>0</enabled>
                <client_secret backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <sort_order>70</sort_order>
            </amazon>
            <twitter>
                <enabled>0</enabled>
                <client_secret backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <request_email>0</request_email>
                <sort_order>80</sort_order>
            </twitter>
            <test>
                <enabled>0</enabled>
                <sort_order>999</sort_order>
            </test>
        </softaware_sociallogin>
    </default>
</config>
