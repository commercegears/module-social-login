<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Softaware\SocialLogin\Api\LinkRepositoryInterface" type="Softaware\SocialLogin\Model\LinkRepository"/>
    <preference for="Softaware\SocialLogin\Api\Data\LinkInterface" type="Softaware\SocialLogin\Model\Link"/>

    <!-- Providers: add your own by implementing ProviderInterface and adding it here -->
    <type name="Softaware\SocialLogin\Model\Provider\ProviderPool">
        <arguments>
            <argument name="providers" xsi:type="array">
                <item name="google" xsi:type="object">Softaware\SocialLogin\Model\Provider\Google</item>
                <item name="apple" xsi:type="object">Softaware\SocialLogin\Model\Provider\Apple</item>
                <item name="facebook" xsi:type="object">Softaware\SocialLogin\Model\Provider\Facebook</item>
                <item name="microsoft" xsi:type="object">Softaware\SocialLogin\Model\Provider\Microsoft</item>
                <item name="github" xsi:type="object">Softaware\SocialLogin\Model\Provider\Github</item>
                <item name="linkedin" xsi:type="object">Softaware\SocialLogin\Model\Provider\LinkedIn</item>
                <item name="amazon" xsi:type="object">Softaware\SocialLogin\Model\Provider\Amazon</item>
                <item name="twitter" xsi:type="object">Softaware\SocialLogin\Model\Provider\X</item>
                <item name="test" xsi:type="object">Softaware\SocialLogin\Model\Provider\TestProvider</item>
            </argument>
        </arguments>
    </type>
    <type name="Softaware\SocialLogin\Model\Provider\TestProvider">
        <arguments>
            <argument name="urlBuilder" xsi:type="object">Magento\Framework\Url</argument>
        </arguments>
    </type>

    <!-- Callback URLs are storefront URLs, also when shown in the admin -->
    <virtualType name="Softaware\SocialLogin\Model\FrontendUrlFactory" type="Magento\Framework\UrlFactory">
        <arguments>
            <argument name="instanceName" xsi:type="string">Magento\Framework\Url</argument>
        </arguments>
    </virtualType>
    <type name="Softaware\SocialLogin\Model\CallbackUrl">
        <arguments>
            <argument name="urlFactory" xsi:type="object">Softaware\SocialLogin\Model\FrontendUrlFactory</argument>
        </arguments>
    </type>

    <!-- Log file: var/log/softaware_sociallogin.log (no secrets, codes or tokens are logged) -->
    <virtualType name="Softaware\SocialLogin\Logger\Handler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/softaware_sociallogin.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="Softaware\SocialLogin\Logger\Logger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">softaware_sociallogin</argument>
            <argument name="handlers" xsi:type="array">
                <item name="file" xsi:type="object">Softaware\SocialLogin\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Softaware\SocialLogin\Controller\Auth\Start">
        <arguments>
            <argument name="logger" xsi:type="object">Softaware\SocialLogin\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Softaware\SocialLogin\Controller\Auth\Callback">
        <arguments>
            <argument name="logger" xsi:type="object">Softaware\SocialLogin\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Softaware\SocialLogin\Controller\Account\CompletePost">
        <arguments>
            <argument name="logger" xsi:type="object">Softaware\SocialLogin\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Softaware\SocialLogin\Controller\Account\ConfirmPost">
        <arguments>
            <argument name="logger" xsi:type="object">Softaware\SocialLogin\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Softaware\SocialLogin\Model\Account\CustomerCreator">
        <arguments>
            <argument name="logger" xsi:type="object">Softaware\SocialLogin\Logger\Logger</argument>
        </arguments>
    </type>

    <!-- Admin grid -->
    <type name="Softaware\SocialLogin\Model\ResourceModel\Link\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">softaware_social_login</argument>
            <argument name="resourceModel" xsi:type="string">Softaware\SocialLogin\Model\ResourceModel\Link</argument>
        </arguments>
    </type>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="softaware_sociallogin_link_listing_data_source" xsi:type="string">Softaware\SocialLogin\Model\ResourceModel\Link\Grid\Collection</item>
            </argument>
        </arguments>
    </type>

    <!-- CLI -->
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="softaware_sociallogin_links" xsi:type="object">Softaware\SocialLogin\Console\Command\LinksCommand</item>
                <item name="softaware_sociallogin_unlink" xsi:type="object">Softaware\SocialLogin\Console\Command\UnlinkCommand</item>
                <item name="softaware_sociallogin_selftest" xsi:type="object">Softaware\SocialLogin\Console\Command\SelfTestCommand</item>
            </argument>
        </arguments>
    </type>

    <!-- Admin config: callback URL shown under each provider's "Enabled" switch -->
    <virtualType name="Softaware\SocialLogin\Model\Config\Comment\GoogleCallbackUrl" type="Softaware\SocialLogin\Model\Config\Comment\CallbackUrl">
        <arguments>
            <argument name="providerCode" xsi:type="string">google</argument>
            <argument name="hint" xsi:type="string">Google Cloud Console &gt; APIs &amp; Services &gt; Credentials: create an OAuth client ID of type "Web application" and add this URL under "Authorised redirect URIs".</argument>
        </arguments>
    </virtualType>
    <virtualType name="Softaware\SocialLogin\Model\Config\Comment\AppleCallbackUrl" type="Softaware\SocialLogin\Model\Config\Comment\CallbackUrl">
        <arguments>
            <argument name="providerCode" xsi:type="string">apple</argument>
            <argument name="hint" xsi:type="string">Apple Developer &gt; Certificates, Identifiers &amp; Profiles: create a Services ID with "Sign in with Apple", add your domain and this URL as Return URL, and create a key with "Sign in with Apple" enabled.</argument>
        </arguments>
    </virtualType>
    <virtualType name="Softaware\SocialLogin\Model\Config\Comment\FacebookCallbackUrl" type="Softaware\SocialLogin\Model\Config\Comment\CallbackUrl">
        <arguments>
            <argument name="providerCode" xsi:type="string">facebook</argument>
            <argument name="hint" xsi:type="string">Meta for Developers &gt; your app &gt; Facebook Login &gt; Settings: add this URL to "Valid OAuth Redirect URIs". The app needs the "email" permission.</argument>
        </arguments>
    </virtualType>
    <virtualType name="Softaware\SocialLogin\Model\Config\Comment\MicrosoftCallbackUrl" type="Softaware\SocialLogin\Model\Config\Comment\CallbackUrl">
        <arguments>
            <argument name="providerCode" xsi:type="string">microsoft</argument>
            <argument name="hint" xsi:type="string">Microsoft Entra admin centre &gt; App registrations: register an app for "Accounts in any organisational directory and personal Microsoft accounts", add this URL as a "Web" redirect URI and create a client secret.</argument>
        </arguments>
    </virtualType>
    <virtualType name="Softaware\SocialLogin\Model\Config\Comment\GithubCallbackUrl" type="Softaware\SocialLogin\Model\Config\Comment\CallbackUrl">
        <arguments>
            <argument name="providerCode" xsi:type="string">github</argument>
            <argument name="hint" xsi:type="string">GitHub &gt; Settings &gt; Developer settings &gt; OAuth Apps: create an app and enter this URL as "Authorization callback URL".</argument>
        </arguments>
    </virtualType>
    <virtualType name="Softaware\SocialLogin\Model\Config\Comment\LinkedinCallbackUrl" type="Softaware\SocialLogin\Model\Config\Comment\CallbackUrl">
        <arguments>
            <argument name="providerCode" xsi:type="string">linkedin</argument>
            <argument name="hint" xsi:type="string">LinkedIn Developers &gt; your app &gt; Products: add "Sign In with LinkedIn using OpenID Connect"; under Auth add this URL to "Authorized redirect URLs".</argument>
        </arguments>
    </virtualType>
    <virtualType name="Softaware\SocialLogin\Model\Config\Comment\AmazonCallbackUrl" type="Softaware\SocialLogin\Model\Config\Comment\CallbackUrl">
        <arguments>
            <argument name="providerCode" xsi:type="string">amazon</argument>
            <argument name="hint" xsi:type="string">Amazon Developer Console &gt; Login with Amazon: create a security profile and add this URL under Web Settings &gt; "Allowed Return URLs".</argument>
        </arguments>
    </virtualType>
    <virtualType name="Softaware\SocialLogin\Model\Config\Comment\TwitterCallbackUrl" type="Softaware\SocialLogin\Model\Config\Comment\CallbackUrl">
        <arguments>
            <argument name="providerCode" xsi:type="string">twitter</argument>
            <argument name="hint" xsi:type="string">X Developer Portal &gt; your app &gt; User authentication settings: enable OAuth 2.0 (type "Web App"), and enter this URL as "Callback URI / Redirect URL".</argument>
        </arguments>
    </virtualType>
</config>
