<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="softaware_sociallogin" translate="label" type="text" sortOrder="300" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Social Login</label>
            <tab>softaware</tab>
            <resource>Softaware_SocialLogin::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <comment><![CDATA[When off, no buttons are shown and the sign-in URLs return 404. Existing links are kept.]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="login_mode" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sign-in Window</label>
                    <comment><![CDATA[Popup keeps the shopper on the current page; browsers that block the popup fall back to a full-page redirect.]]></comment>
                    <source_model>Softaware\SocialLogin\Model\Config\Source\LoginMode</source_model>
                </field>
                <field id="button_style" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Button Style</label>
                    <source_model>Softaware\SocialLogin\Model\Config\Source\ButtonStyle</source_model>
                </field>
                <field id="button_theme" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Button Colour</label>
                    <source_model>Softaware\SocialLogin\Model\Config\Source\ButtonTheme</source_model>
                </field>
            </group>
            <group id="display" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Where to Show the Buttons</label>
                <comment><![CDATA[The buttons are also available as the CMS widget "Softaware Social Login Buttons" (Content &gt; Widgets, or Insert Widget in a page or block) and as the layout block <code>Softaware\SocialLogin\Block\Buttons</code>.]]></comment>
                <field id="login_page" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sign-in Page</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="register_page" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Create Account Page</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="auth_popup" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Authentication Popup and Checkout Sign-in</label>
                    <comment><![CDATA[Luma: the "Checkout using your account" popup and the "Sign In" link on the checkout page. Hyvä: the authentication popup (the Hyvä checkout uses the Luma checkout).]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="checkout" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Checkout Email Step</label>
                    <comment><![CDATA[Above the email field in the shipping step of the checkout (guests only).]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            <group id="account" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Accounts</label>
                <field id="allow_registration" translate="label comment" type="select" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Create New Accounts</label>
                    <comment><![CDATA[Set to "No" to let only existing customers sign in with a provider (for example a trade-only shop). Shoppers without an account are asked to register first.]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="link_mode" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Existing Account with the Same Email</label>
                    <comment><![CDATA[Automatic linking only applies to addresses the provider has verified and is responsible for (for example Gmail and Google Workspace addresses at Google, or a verified X address). Other addresses, and addresses the shopper typed in, always require the account password.]]></comment>
                    <source_model>Softaware\SocialLogin\Model\Config\Source\LinkMode</source_model>
                </field>
                <field id="send_welcome_email" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Send Welcome Email to New Customers</label>
                    <comment><![CDATA[Uses the template "Welcome Email (without password)" from Customer Configuration &gt; Create New Account Options. Addresses the provider has not verified (or that the shopper typed in) get the confirmation email instead, and the account can be used once it is confirmed.]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="customer_group" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Customer Group for Social Sign-ups</label>
                    <source_model>Softaware\SocialLogin\Model\Config\Source\CustomerGroup</source_model>
                </field>
                <field id="redirect" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>After Sign-in</label>
                    <source_model>Softaware\SocialLogin\Model\Config\Source\RedirectTarget</source_model>
                </field>
                <field id="redirect_custom_url" translate="label comment" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Custom URL</label>
                    <comment><![CDATA[A path such as <code>sale.html</code> or a full URL of this store.]]></comment>
                    <depends><field id="redirect">custom</field></depends>
                </field>
            </group>
            <group id="google" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Google</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><model>Softaware\SocialLogin\Model\Config\Comment\GoogleCallbackUrl</model></comment>
                </field>
                <field id="client_id" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Client ID</label>
                </field>
                <field id="client_secret" translate="label comment" type="obscure" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Client Secret</label>
                    <comment><![CDATA[Stored encrypted.]]></comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="label" translate="label comment" type="text" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Button Label</label>
                    <comment><![CDATA[Leave empty for "Continue with Google".]]></comment>
                </field>
                <field id="sort_order" translate="label comment" type="text" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sort Order</label>
                    <validate>validate-number</validate>
                </field>
            </group>
            <group id="facebook" translate="label" type="text" sortOrder="120" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Facebook</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><model>Softaware\SocialLogin\Model\Config\Comment\FacebookCallbackUrl</model></comment>
                </field>
                <field id="client_id" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>App ID</label>
                </field>
                <field id="client_secret" translate="label comment" type="obscure" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>App Secret</label>
                    <comment><![CDATA[Stored encrypted.]]></comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="graph_version" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Graph API Version</label>
                    <comment><![CDATA[Default: <code>v26.0</code>. Tick "Use system value" to use the version this module ships with, or enter another version, for example when Meta retires the one you use.]]></comment>
                </field>
                <field id="label" translate="label comment" type="text" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Button Label</label>
                    <comment><![CDATA[Leave empty for "Continue with Facebook".]]></comment>
                </field>
                <field id="sort_order" translate="label comment" type="text" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sort Order</label>
                    <validate>validate-number</validate>
                </field>
            </group>
            <group id="twitter" translate="label" type="text" sortOrder="170" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>X (Twitter)</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><model>Softaware\SocialLogin\Model\Config\Comment\TwitterCallbackUrl</model></comment>
                </field>
                <field id="client_id" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Client ID</label>
                    <comment><![CDATA[OAuth 2.0 Client ID (not the API key).]]></comment>
                </field>
                <field id="client_secret" translate="label comment" type="obscure" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Client Secret</label>
                    <comment><![CDATA[Leave empty for a public client (PKCE only). Stored encrypted.]]></comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="request_email" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Request Email Address</label>
                    <comment><![CDATA[Only switch on when the X app has the email permission. Without it, shoppers are asked to type their email address once.]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="label" translate="label comment" type="text" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Button Label</label>
                    <comment><![CDATA[Leave empty for "Continue with X".]]></comment>
                </field>
                <field id="sort_order" translate="label comment" type="text" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sort Order</label>
                    <validate>validate-number</validate>
                </field>
            </group>
            <group id="test" translate="label comment" type="text" sortOrder="900" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Test Provider (Developers Only)</label>
                <comment><![CDATA[<strong>For development only.</strong> Adds a "Test provider" button that lets anyone choose any identity. It works only when Magento runs in developer mode, and its email addresses are never treated as verified, so it cannot sign in to an existing account without that account's password. Never needed on a live store.]]></comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="sort_order" translate="label" type="text" sortOrder="90" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Sort Order</label>
                    <validate>validate-number</validate>
                </field>
            </group>
        </section>
    </system>
</config>
